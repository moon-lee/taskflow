{
  "name": "taskflow",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "src/main.ts",
  "financeExtension": {
    "id": "taskflow",
    "displayName": "Taskflow",
    "version": "0.1.0",
    "description": "Taskflow extension",
    "themeColor": "#6366F1",
    "activationEvents": ["onView:taskflow"],
    "contributions": {
      "views": [{ "id": "taskflow", "name": "Taskflow", "icon": "assets/icon.svg" }],
      "commands": [{ "id": "taskflow.hello", "title": "Taskflow: Hello" }],
      "navigation": [{ "id": "taskflow-main", "label": "Taskflow", "command": "taskflow.hello", "group": "Taskflow" }],
      "configuration": [
        { "key": "taskflow.themeColor", "type": "string", "label": "Accent color for icons, topbar actions, and in-view highlights (hex).", "default": "#6366F1", "pattern": "^#[0-9A-Fa-f]{6}$", "formatHint": "#RRGGBB", "placeholder": "#6366F1" }
      ],
      "allowedCommands": ["taskflow.hello"],
      "allowedUiEvents": []
    },
    "main": "src/main.ts"
  },
  "scripts": {
    "dev": "vite",
    "build": "node D:/finance_flow_ai/scripts/sdk/cli.mjs build .",
    "version:bump": "node scripts/version-bump.mjs",
    "release": "node scripts/version-bump.mjs && node D:/finance_flow_ai/scripts/sdk/cli.mjs build ."
  },
  "devDependencies": {
    "vite": "^5.4.0",
    "typescript": "^5.5.0"
  },
  "dependencies": {
    "lit": "^3.1.0"
  }
}
