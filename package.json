{
  "name": "taskflow",
  "version": "0.1.8",
  "private": true,
  "type": "module",
  "main": "src/main.ts",
  "financeExtension": {
    "id": "taskflow",
    "displayName": "Taskflow",
    "version": "0.1.8",
    "description": "Taskflow trackers: blood pressure diary and todo list",
    "themeColor": "#64748B",
    "activationEvents": [
      "onView:taskflow",
      "onStartup"
    ],
    "contributions": {
      "views": [
        {
          "id": "taskflow",
          "name": "Taskflow",
          "icon": "assets/icon.svg"
        }
      ],
      "commands": [
        {
          "id": "taskflow.show-overview",
          "title": "BP Diary: Overview"
        },
        {
          "id": "taskflow.show-todos",
          "title": "Todo List"
        }
      ],
      "navigation": [
        {
          "id": "taskflow-overview",
          "label": "BP Diary",
          "command": "taskflow.show-overview",
          "group": "Task Flow"
        },
        {
          "id": "taskflow-todos",
          "label": "Todo List",
          "command": "taskflow.show-todos",
          "group": "Task Flow"
        }
      ],
      "configuration": [
        {
          "key": "taskflow.themeColor",
          "type": "string",
          "label": "Accent color for icons, topbar actions, and in-view highlights (hex).",
          "default": "#64748B",
          "pattern": "^#[0-9A-Fa-f]{6}$",
          "formatHint": "#RRGGBB",
          "placeholder": "#64748B"
        }
      ],
      "allowedCommands": [
        "taskflow.show-overview",
        "taskflow.show-todos"
      ],
      "allowedUiEvents": [
        "entry-create",
        "entry-edit",
        "entry-delete",
        "todo-create",
        "todo-toggle",
        "todo-delete",
        "todo-rename",
        "todo-clear-completed"
      ]
    },
    "tables": [
      {
        "name": "taskflow_bp_readings",
        "columns": [
          {
            "name": "sys",
            "type": "integer",
            "nullable": false,
            "min": 0,
            "max": 400
          },
          {
            "name": "dia",
            "type": "integer",
            "nullable": false,
            "min": 0,
            "max": 400
          },
          {
            "name": "taken_at",
            "type": "datetime",
            "nullable": false,
            "index": true
          }
        ]
      },
      {
        "name": "taskflow_todos",
        "columns": [
          {
            "name": "title",
            "type": "text",
            "nullable": false
          },
          {
            "name": "is_done",
            "type": "boolean",
            "nullable": false,
            "default": false
          },
          {
            "name": "due_date",
            "type": "date",
            "nullable": true
          },
          {
            "name": "priority",
            "type": "text",
            "nullable": false,
            "default": "medium",
            "enumOptions": [
              "low",
              "medium",
              "high"
            ]
          }
        ]
      }
    ],
    "main": "src/main.ts"
  },
  "scripts": {
    "dev": "vite",
    "build": "node D:/finance_flow_ai/scripts/sdk/cli.mjs build .",
    "test": "vitest run",
    "version:bump": "node scripts/version-bump.mjs",
    "release": "node scripts/version-bump.mjs && node D:/finance_flow_ai/scripts/sdk/cli.mjs build ."
  },
  "devDependencies": {
    "typescript": "^5.5.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.9"
  },
  "dependencies": {
    "chart.js": "^4.5.1",
    "lit": "^3.1.0"
  }
}
